{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "nodenext"
  },
  "include": ["src"],
  "exclude": [
    // drives the REAL web Predictor against the engine's send/reconcile
    // cadence (it has no DOM deps); outside rootDir by nature. Vitest still
    // runs it — tsc just can't nest the web package under src/. The imported
    // predict.ts is typechecked by the web package's own tsc.
    "src/test/predict.test.ts",
    // Runs the real web targeting method without creating a renderer.
    "src/test/client-target.test.ts"
  ]
}

