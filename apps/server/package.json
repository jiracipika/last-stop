{
  "name": "@last-stop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --external:fsevents --banner:js=\"import { createRequire as __lsRequire } from 'node:module'; const require = __lsRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.4",
    "@last-stop/shared": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
